# Copy to terraform.tfvars (gitignored) and fill in your values.
# These same values can be set as GitHub Actions repo Variables for CI.

aws_region       = "us-east-1"
project          = "devops-demo"
environment      = "dev"
instance_type    = "t3.small"
volume_size      = 30

# Required (no defaults):
ami_id           = "ami-0abcdef1234567890"   # Ubuntu AMI for your region
key_name         = "your-key-pair"           # existing EC2 key pair name
my_ip            = "203.0.113.10/32"         # your public IP, CIDR notation